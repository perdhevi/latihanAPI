# Local development values. Compose reads credentials from SECRETS_DIR instead;
# see docker-compose.prod.yml for a real deployment.
HTTP_ADDR=:8080
LOG_LEVEL=info
# For `make run`: the API connects as latihan_app, which cannot change the schema.
DATABASE_URL=postgres://latihan_app:latihan_app_dev@localhost:5432/latihan?sslmode=disable
# For `make migrate-up`: migrations run as latihan_migrator, the schema owner.
MIGRATE_DATABASE_URL=postgres://latihan_migrator:latihan_migrator_dev@localhost:5432/latihan?sslmode=disable
# Integration tests create and drop schemas, so they use the superuser. Never production.
TEST_DATABASE_URL=postgres://latihan:latihan@localhost:5432/latihan?sslmode=disable

# Production (docker-compose.prod.yml): run scripts/init-secrets.sh, then
#SECRETS_DIR=./secrets
#DOMAIN=api.example.com
#ACME_EMAIL=you@example.com
# and set AUTH_JWT_ISSUER=https://api.example.com below.

# Authentication (required). The API refuses to start without a provider.
# Keep exactly one block active.

# Built-in accounts: email and password, tokens signed by this service. Works
# with no external accounts. Compose creates the key in a volume and sets
# AUTH_JWT_KEY_FILE itself; for `make run`, create it with `make keygen`.
AUTH_PROVIDER=jwt
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_KEY_FILE=.keys/signing.pem
#AUTH_JWT_PREVIOUS_KEY_FILES=
#AUTH_JWT_ACCESS_TTL=15m
#AUTH_JWT_REFRESH_TTL=720h

# Firebase Authentication
#AUTH_PROVIDER=firebase
#AUTH_FIREBASE_PROJECT_ID=my-project

# Amazon Cognito. Use access tokens for APIs unless you have a reason not to.
#AUTH_PROVIDER=cognito
#AUTH_COGNITO_REGION=ap-southeast-1
#AUTH_COGNITO_USER_POOL_ID=ap-southeast-1_AbC123xyz
#AUTH_COGNITO_CLIENT_ID=your-app-client-id
#AUTH_COGNITO_TOKEN_USE=access

# Any OpenID Connect issuer (Keycloak, Auth0, Zitadel, ...). HTTPS only.
#AUTH_PROVIDER=oidc
#AUTH_OIDC_ISSUER=https://id.example.com/realms/latihan
#AUTH_OIDC_AUDIENCE=latihan-api
#AUTH_OIDC_JWKS_URL=
#AUTH_OIDC_ALGORITHMS=RS256

# Abuse limits (defaults shown). Rate limits are N/unit:burst with unit s, m or h, or off.
#RATE_LIMIT_IP=50/s:100
#RATE_LIMIT_USER=10/s:30
#RATE_LIMIT_AUTH=10/m:10
#MAX_IN_FLIGHT=256
# Behind a reverse proxy, list it here so X-Forwarded-For is honoured (IPs or CIDRs).
#TRUSTED_PROXIES=
#DB_MAX_CONNS=10
#DB_STATEMENT_TIMEOUT=5s

# Reject PUT and DELETE without If-Match (428) instead of last-write-wins.
#REQUIRE_IF_MATCH=false

# Observability. /metrics (and pprof, if enabled) are served on ADMIN_ADDR, a
# separate port that must never be published. Tracing is off unless an OTLP
# endpoint is set; with the Compose observability profile, use http://jaeger:4318.
#ADMIN_ADDR=:9090
#ADMIN_PPROF=false
#OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#OTEL_TRACES_SAMPLER=parentbased_traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1
