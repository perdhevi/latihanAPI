# Local development credentials only. Use managed secrets and TLS in production.
HTTP_ADDR=:8080
DATABASE_URL=postgres://latihan:latihan@localhost:5432/latihan?sslmode=disable
LOG_LEVEL=info
TEST_DATABASE_URL=postgres://latihan:latihan@localhost:5432/latihan?sslmode=disable

# Authentication (required). The API refuses to start without a provider.
# Keep exactly one block active.

# Built-in accounts: email and password, tokens signed by this service. Works
# with no external accounts. Compose creates the key in a volume and sets
# AUTH_JWT_KEY_FILE itself; for `make run`, create it with `make keygen`.
AUTH_PROVIDER=jwt
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_KEY_FILE=.keys/signing.pem
#AUTH_JWT_PREVIOUS_KEY_FILES=
#AUTH_JWT_ACCESS_TTL=15m
#AUTH_JWT_REFRESH_TTL=720h

# Firebase Authentication
#AUTH_PROVIDER=firebase
#AUTH_FIREBASE_PROJECT_ID=my-project

# Amazon Cognito. Use access tokens for APIs unless you have a reason not to.
#AUTH_PROVIDER=cognito
#AUTH_COGNITO_REGION=ap-southeast-1
#AUTH_COGNITO_USER_POOL_ID=ap-southeast-1_AbC123xyz
#AUTH_COGNITO_CLIENT_ID=your-app-client-id
#AUTH_COGNITO_TOKEN_USE=access

# Any OpenID Connect issuer (Keycloak, Auth0, Zitadel, ...). HTTPS only.
#AUTH_PROVIDER=oidc
#AUTH_OIDC_ISSUER=https://id.example.com/realms/latihan
#AUTH_OIDC_AUDIENCE=latihan-api
#AUTH_OIDC_JWKS_URL=
#AUTH_OIDC_ALGORITHMS=RS256
